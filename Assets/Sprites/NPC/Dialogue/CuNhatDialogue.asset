  npcName: "C\u1EADu Nh\u1EA5t B\u1EE7n R\u1EE7n"
  npcPortrait: {fileID: 7403360267442092702, guid: 09c25d8e4a0f98e44b7dded6b367d938, type: 3}
  dialogueLines:
  - "C\u1EADu g\xEC \u01A1i, t\xF4i mu\u1ED1n \u0111i ch\u1EE3"
  - "Nh\u01B0ng m\xE0 t\xF4i y\u1EBFu qu\xE1, c\u1EADu mua cho t\xF4i v\u1EDBi"
  - "C\u1EA3m \u01A1n c\u1EADu!"
  - "Mua gi\xFAp t\xF4i nh\u01B0ng th\u1EE9 n\xE0y "
  - "V\u1EADy \u0111\u1EC3 t\xF4i t\u1EF1 l\u1EBFt \u0111i mua"
  - "Th\xE2n gi\xE0 n\xE0y c\xF2n tr\xE2u b\xF2 l\u1EAFm"
  - "Ch\u01B0a \u0111\u1EE7 m\xE0 c\u1EADu"
  - "\u0110\u1EA7y \u0111\u1EE7 r\u1ED3i h\u1EA3 c\u1EADu"
  - "G\u1EEDi c\u1EADu ti\u1EC1n \u0111\xE3 gi\xFAp t\xF4i"
  autoProgressLines: 010001000100000100
  endDialogueLines: 000000010001010001
