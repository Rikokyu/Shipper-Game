  npcName: "\xD4ng b\u1EA3y chill guy"
  npcPortrait: {fileID: 492564053798499885, guid: 09c25d8e4a0f98e44b7dded6b367d938, type: 3}
  dialogueLines:
  - "C\u1EADu g\xEC \u01A1i, t\xF4i \u0111ang \u0111\xF3i!!!"
